{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cat-fortune",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // TheCatAPI の利用回数（全員で1分間に10回まで）と取得結果のキャッシュ
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cat-fortune-db",
      "database_id": "2765eb7d-e69c-4699-9dee-e1e20313da56",
      "migrations_dir": "migrations"
    }
  ],
  // /api/cat は1つのIPにつき60秒あたり30回まで
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
