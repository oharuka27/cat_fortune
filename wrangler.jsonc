{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cat-fortune",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
